{
  "name": "spotify-any-thing",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "dev": "vite serve -c ./vite.config.js ./webapp",
    "prod": "vite build -c ./vite.config.js ./webapp && vite preview",
    "build": "vite build -c ./vite.config.js ./webapp",
    "format": "prettier --write 'webapp/src/**/*.ts' 'webapp/src/**/*.tsx'",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-singlefile": "^2.0.2"
  },
  "volta": {
    "node": "20.15.1"
  }
}
